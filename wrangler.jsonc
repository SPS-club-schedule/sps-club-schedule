{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sps-club-api",
  "account_id": "f8f6e5eb8c25f30da5e3af3f54a994a6",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "CLUB_SERVICE", "class_name": "ClubService" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ClubService"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://sps-club-schedule.github.io,https://farawayshore.github.io",
    "REGISTRATION_OPEN": "true",
    "EXPERIENCE_CLUB_ID": "c_4b41fd4ed7f3812cb1c624261a986141",
    "BOOKING_CLUB_ID": "c_4b41fd4ed7f3812cb1c624261a986141",
    "BOOKING_SYNC_URL": "https://sysu-phy-club-book.folderrewind.top/api/integrations/sps"
  },
  "observability": { "enabled": false }
}
